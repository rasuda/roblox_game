{
  "name": "Football Transfer Rivals",
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": true,
        "StreamingMinRadius": 128,
        "StreamingTargetRadius": 384
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "TransferGame": {
        "$path": "game/replicated"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "TransferGame": {
        "$path": "game/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {"CharacterWalkSpeed": 16},
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "TransferGame": {"$path": "game/client"}
      }
    }
  }
}
